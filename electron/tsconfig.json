{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDir": "..",
    "outDir": "../dist-electron",
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "../premium/electron/**/*.ts"
  ],
  "exclude": [
    "db/seedDemo.ts",
    "db/test-db.ts",
    "test/**",
    "**/* - Backup.ts",
    "**/* - backup*.ts",
    "**/* -  backup*.ts",
    "EnterpriseArchitecture.ts",
    "WindowManager.ts",
    "main/AnalyticsService.ts",
    "main/SafeIPC.ts",
    "main/SidecarManager.ts",
    "main/STTErrorHandler.ts",
    "sidecar/**"
  ]
}
